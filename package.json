{
  "name": "madeira-admin",
  "version": "1.0.0",
  "description": "Sistema de Gestão Financeira para Igreja",
  "main": "src/main/index.js",
  "homepage": "./",
  "author": "Zaione20",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && npm run electron-dev\"",
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "electron-dev": "electron .",
    "electron-build": "npm run react-build && electron-builder",
    "build": "npm run react-build && npm run electron-build",
    "release": "npm run react-build && electron-builder --publish=always",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "@mui/material": "^5.12.0",
    "@mui/icons-material": "^5.12.0",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "recharts": "^2.10.0",
    "axios": "^1.3.0",
    "date-fns": "^2.29.0",
    "uuid": "^9.0.0",
    "joi": "^17.9.0",
    "bcrypt": "^5.1.0",
    "jsonwebtoken": "^9.0.0",
    "sqlite3": "^5.1.6",
    "sequelize": "^6.35.0",
    "dotenv": "^16.0.0",
    "cors": "^2.8.5",
    "electron-squirrel-startup": "^1.1.0",
    "pdfkit": "^0.13.0",
    "exceljs": "^4.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1"
  },
  "devDependencies": {
    "electron": "^22.0.0",
    "electron-builder": "^24.4.0",
    "react-scripts": "5.0.1",
    "concurrently": "^7.6.0",
    "wait-on": "^7.0.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/jest-dom": "^5.16.0",
    "nodemon": "^2.0.20",
    "eslint": "^8.30.0",
    "prettier": "^2.8.0"
  },
  "build": {
    "appId": "com.madeira.admin",
    "productName": "Madeira Admin",
    "directories": {
      "buildResources": "public",
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "src/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
